rules_version = '2';

// ============================================================
//   قواعد أمان تخزين الصور
//   انسخ الملف ده والصقه في:
//   Firebase Console ← Storage ← Rules ← Publish
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@store.com';
    }

    // صور المنتجات: أي حد يشوفها، صاحب المتجر بس اللي يرفع
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // صور الشريط المتحرك
    match /ticker/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
